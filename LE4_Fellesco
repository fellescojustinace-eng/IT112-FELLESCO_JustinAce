#include <stdio.h>
#include <string.h>

int main() {
    char name[100];
    char section[50];
    float grade1, grade2, grade3, grade4;
    float average;

    // Input student information
    printf("Enter Complete Name: ");
    fgets(name, sizeof(name), stdin);
    name[strcspn(name, "\n")] = '\0';

    printf("Enter Section : ");
    fgets(section, sizeof(section), stdin);
    section[strcspn(section, "\n")] = '\0';

    printf("\n");

    // Input quarter grades
    printf("Enter 1st Quarter Grade: ");
    scanf("%f", &grade1);

    printf("Enter 2nd Quarter Grade: ");
    scanf("%f", &grade2);

    printf("Enter 3rd Quarter Grade: ");
    scanf("%f", &grade3);

    printf("Enter 4th Quarter Grade: ");
    scanf("%f", &grade4);

    // Calculate average
    average = (grade1 + grade2 + grade3 + grade4) / 4;

    // Display results
    printf("\n");
    printf("Student: %s\n", name);
    printf("Section: %s\n", section);
    printf("General Average: %.2f\n", average);

    // Evaluate average and display remarks
    if (average >= 90 && average <= 100) {
        printf("Remarks: Outstanding\n");
    }
    else if (average >= 85) {
        printf("Remarks: Very Satisfactory\n");
    }
    else if (average >= 80) {
        printf("Remarks: Satisfactory\n");
    }
    else if (average >= 75) {
        printf("Remarks: Fair\n");
    }
    else {
        printf("Remarks: Failed\n");
    }

    return 0;
}
